<!-- ════ STICKY ATC BAR ════ -->
<div class="cv-sticky-bar" id="cvStickyBar">
  <span class="cv-sticky-name">CutVolt Pro — Cordless Electric Cutter</span>
  <span class="cv-sticky-price">{{ product.price | money }}</span>
  <button class="cv-sticky-btn" onclick="document.getElementById('cv-product-form').submit()">Add to Cart</button>
</div>

<script>
  // Gallery switcher
  function cvChangeImg(src, el) {
    document.getElementById('cvMainImgEl').src = src;
    document.querySelectorAll('.cv-thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }

  // Qty controls
  function cvQtyChange(delta) {
    const input = document.getElementById('cvQtyInput');
    const val = Math.max(1, parseInt(input.value || 1) + delta);
    input.value = val;
  }

  // Color selector
  function cvSelectColor(name, el) {
    document.getElementById('cvSelectedColor').textContent = name;
    document.querySelectorAll('.cv-color-swatch').forEach(s => s.classList.remove('active'));
    el.classList.add('active');
  }

  // Countdown timer
  (function() {
    const el = document.getElementById('cvCountdown');
    if (!el) return;
    const KEY = 'cv_end_time';
    let end = localStorage.getItem(KEY);
    if (!end || Date.now() > Number(end)) {
      end = Date.now() + 24 * 3600 * 1000;
      localStorage.setItem(KEY, end);
    }
    function tick() {
      const diff = Math.max(0, end - Date.now());
      const h = String(Math.floor(diff / 3600000)).padStart(2,'0');
      const m = String(Math.floor((diff % 3600000) / 60000)).padStart(2,'0');
      const s = String(Math.floor((diff % 60000) / 1000)).padStart(2,'0');
      el.textContent = h + ':' + m + ':' + s;
      if (diff > 0) setTimeout(tick, 1000);
    }
    tick();
  })();

  // Sticky ATC bar
  (function() {
    const hero = document.querySelector('.cv-hero');
    const bar  = document.getElementById('cvStickyBar');
    if (!hero || !bar) return;
    window.addEventListener('scroll', function() {
      const bottom = hero.getBoundingClientRect().bottom;
      bar.classList.toggle('visible', bottom < 0);
    }, { passive: true });
  })();

  // FAQ accordion
  document.querySelectorAll('.cv-faq-q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const item = btn.closest('.cv-faq-item');
      const ans  = item.querySelector('.cv-faq-a');
      const open = item.classList.contains('open');
      document.querySelectorAll('.cv-faq-item').forEach(function(i) {
        i.classList.remove('open');
        i.querySelector('.cv-faq-a').classList.remove('open');
      });
      if (!open) { item.classList.add('open'); ans.classList.add('open'); }
    });
  });

  // ATC button feedback
  var atcBtn = document.getElementById('cvAtcBtn');
  if (atcBtn) {
    document.getElementById('cv-product-form').addEventListener('submit', function() {
      atcBtn.textContent = '✓ Added to Cart!';
      atcBtn.style.background = '#16a34a';
      setTimeout(function() {
        atcBtn.textContent = '🛒 Add to Cart';
        atcBtn.style.background = '';
      }, 2500);
    });
  }
</script>

