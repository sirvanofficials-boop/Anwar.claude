{% comment %} CutVolt Pro — Full Product Landing Page Section {% endcomment %}

<style>
/* ════════════════════════════════════════
   CutVolt Pro — Shopify Product Page
   White Background · Orange Accents
   ════════════════════════════════════════ */

*, *::before, *::after { box-sizing: border-box; }

:root {
  --cv-orange:      #f26419;
  --cv-orange-dark: #d4540e;
  --cv-orange-light:#fff3ec;
  --cv-dark:        #111827;
  --cv-gray:        #6b7280;
  --cv-light:       #f9fafb;
  --cv-border:      #e5e7eb;
  --cv-green:       #16a34a;
  --cv-green-light: #dcfce7;
  --cv-red:         #dc2626;
  --cv-red-light:   #fee2e2;
  --cv-white:       #ffffff;
  --cv-radius:      10px;
  --cv-radius-lg:   16px;
  --cv-shadow:      0 2px 16px rgba(0,0,0,0.08);
  --cv-shadow-lg:   0 8px 40px rgba(0,0,0,0.12);
  --cv-font:        'Helvetica Neue', Arial, sans-serif;
}

.cv-wrap { font-family: var(--cv-font); color: var(--cv-dark); background: var(--cv-white); }
.cv-wrap * { margin: 0; padding: 0; list-style: none; text-decoration: none; }
.cv-container { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
.cv-section { padding: 72px 0; }
.cv-section-alt { background: var(--cv-light); }

.cv-tag {
  display: inline-block;
  background: var(--cv-orange-light);
  color: var(--cv-orange);
  border: 1px solid rgba(242,100,25,0.2);
  border-radius: 50px;
  padding: 5px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.cv-section-title {
  font-size: clamp(24px, 4vw, 38px);
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 12px;
  color: var(--cv-dark);
}

.cv-section-sub {
  font-size: 17px;
  color: var(--cv-gray);
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.7;
}

.cv-section-header {
  text-align: center;
  margin-bottom: 52px;
}

/* ── ANNOUNCEMENT BAR ── */
.cv-bar {
  background: var(--cv-dark);
  color: #fff;
  text-align: center;
  padding: 10px 20px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.cv-bar strong { color: var(--cv-orange); }
.cv-bar-ticker span { margin: 0 24px; }

/* ── HERO (Product + Buy Box) ── */
.cv-hero {
  padding: 52px 0 64px;
  background: var(--cv-white);
  border-bottom: 1px solid var(--cv-border);
}

.cv-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
}

/* Gallery */
.cv-gallery { position: sticky; top: 100px; }

.cv-gallery-main {
  border-radius: var(--cv-radius-lg);
  overflow: hidden;
  background: var(--cv-light);
  aspect-ratio: 1;
  margin-bottom: 12px;
  border: 1px solid var(--cv-border);
}

.cv-gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
  cursor: zoom-in;
}
.cv-gallery-main img:hover { transform: scale(1.04); }

.cv-gallery-thumbs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.cv-thumb {
  width: 68px;
  height: 68px;
  border-radius: var(--cv-radius);
  overflow: hidden;
  border: 2px solid var(--cv-border);
  cursor: pointer;
  transition: border-color 0.2s;
  background: var(--cv-light);
  flex-shrink: 0;
}
.cv-thumb:hover, .cv-thumb.active { border-color: var(--cv-orange); }
.cv-thumb img { width: 100%; height: 100%; object-fit: contain; }

/* Buy Box */
.cv-buybox { padding-top: 8px; }

.cv-product-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--cv-green-light);
  color: var(--cv-green);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 16px;
}
.cv-badge-dot {
  width: 7px; height: 7px;
  background: var(--cv-green);
  border-radius: 50%;
  animation: cv-pulse 2s infinite;
}
@keyframes cv-pulse {
  0%,100%{opacity:1;transform:scale(1);}
  50%{opacity:.5;transform:scale(1.4);}
}

.cv-product-title {
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 12px;
  color: var(--cv-dark);
}

.cv-stars-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
}
.cv-stars { color: #f59e0b; font-size: 16px; letter-spacing: 2px; }
.cv-review-count { font-size: 13px; color: var(--cv-gray); }
.cv-review-count a { color: var(--cv-orange); text-decoration: underline; }

.cv-price-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 6px;
}
.cv-price {
  font-size: 36px;
  font-weight: 900;
  color: var(--cv-orange);
  line-height: 1;
}
.cv-price-compare {
  font-size: 20px;
  color: var(--cv-gray);
  text-decoration: line-through;
}
.cv-price-save {
  background: var(--cv-red-light);
  color: var(--cv-red);
  padding: 4px 10px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 700;
}

.cv-price-note {
  font-size: 13px;
  color: var(--cv-gray);
  margin-bottom: 20px;
}

.cv-divider {
  border: none;
  border-top: 1px solid var(--cv-border);
  margin: 20px 0;
}

/* Color variants */
.cv-variants-label {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 10px;
  color: var(--cv-dark);
}
.cv-color-grid {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}
.cv-color-swatch {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 3px solid transparent;
  cursor: pointer;
  transition: border-color 0.2s, transform 0.2s;
  position: relative;
}
.cv-color-swatch:hover, .cv-color-swatch.active {
  border-color: var(--cv-dark);
  transform: scale(1.15);
}
.cv-color-swatch::after {
  content: '';
  position: absolute;
  inset: 2px;
  border-radius: 50%;
}

/* ATC */
.cv-qty-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.cv-qty-label { font-size: 14px; font-weight: 600; }
.cv-qty-ctrl {
  display: flex;
  align-items: center;
  border: 1px solid var(--cv-border);
  border-radius: var(--cv-radius);
  overflow: hidden;
}
.cv-qty-btn {
  width: 36px; height: 36px;
  background: var(--cv-light);
  border: none;
  font-size: 18px;
  cursor: pointer;
  font-family: var(--cv-font);
  transition: background 0.2s;
}
.cv-qty-btn:hover { background: var(--cv-border); }
.cv-qty-input {
  width: 44px;
  text-align: center;
  border: none;
  border-left: 1px solid var(--cv-border);
  border-right: 1px solid var(--cv-border);
  font-size: 15px;
  font-weight: 600;
  height: 36px;
  font-family: var(--cv-font);
}
.cv-qty-input:focus { outline: none; }

.cv-atc-btn {
  width: 100%;
  padding: 17px 24px;
  background: var(--cv-orange);
  color: #fff;
  border: none;
  border-radius: var(--cv-radius-lg);
  font-size: 17px;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
  letter-spacing: 0.01em;
  margin-bottom: 12px;
  font-family: var(--cv-font);
}
.cv-atc-btn:hover {
  background: var(--cv-orange-dark);
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(242,100,25,0.35);
}
.cv-atc-btn:active { transform: translateY(0); }

.cv-buy-now-btn {
  width: 100%;
  padding: 16px 24px;
  background: var(--cv-dark);
  color: #fff;
  border: none;
  border-radius: var(--cv-radius-lg);
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s;
  margin-bottom: 16px;
  font-family: var(--cv-font);
}
.cv-buy-now-btn:hover { background: #374151; }

.cv-mini-trust {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 20px;
}
.cv-mini-trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--cv-gray);
}
.cv-mini-trust-icon { font-size: 15px; }

.cv-key-points {
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--cv-light);
  border-radius: var(--cv-radius-lg);
  padding: 20px;
}
.cv-key-point {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  color: var(--cv-dark);
  line-height: 1.5;
}
.cv-key-point-icon {
  color: var(--cv-orange);
  font-size: 16px;
  flex-shrink: 0;
  margin-top: 1px;
}

/* ── TRUST BAR ── */
.cv-trust-bar {
  background: var(--cv-dark);
  padding: 20px 0;
}
.cv-trust-bar-grid {
  display: flex;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}
.cv-trust-item {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
}
.cv-trust-item-icon { font-size: 20px; }

/* ── PROBLEM / SOLUTION ── */
.cv-ps-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 28px;
  align-items: center;
}
.cv-ps-arrow {
  font-size: 32px;
  text-align: center;
  color: var(--cv-orange);
}
.cv-ps-card {
  border-radius: var(--cv-radius-lg);
  padding: 32px;
  border: 2px solid;
}
.cv-ps-card.problem {
  background: var(--cv-red-light);
  border-color: rgba(220,38,38,0.2);
}
.cv-ps-card.solution {
  background: var(--cv-green-light);
  border-color: rgba(22,163,74,0.2);
}
.cv-ps-icon { font-size: 32px; margin-bottom: 12px; }
.cv-ps-card h3 {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 16px;
}
.cv-ps-list { display: flex; flex-direction: column; gap: 9px; }
.cv-ps-list li {
  font-size: 14px;
  line-height: 1.5;
  color: var(--cv-dark);
}

/* ── FEATURES ── */
.cv-features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.cv-feature-card {
  background: var(--cv-white);
  border: 1.5px solid var(--cv-border);
  border-radius: var(--cv-radius-lg);
  padding: 28px 22px;
  text-align: center;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}
.cv-feature-card:hover {
  border-color: var(--cv-orange);
  box-shadow: 0 6px 24px rgba(242,100,25,0.1);
  transform: translateY(-4px);
}
.cv-feature-icon { font-size: 36px; margin-bottom: 14px; }
.cv-feature-card h3 {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 8px;
}
.cv-feature-card p {
  font-size: 13px;
  color: var(--cv-gray);
  line-height: 1.6;
}

/* ── REAL PRODUCT IMAGE ROW ── */
.cv-blade-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.cv-blade-img {
  width: 100%;
  border-radius: var(--cv-radius-lg);
  box-shadow: var(--cv-shadow-lg);
}
.cv-blade-text h2 {
  font-size: clamp(22px, 3.5vw, 34px);
  font-weight: 800;
  margin-bottom: 16px;
  line-height: 1.25;
}
.cv-blade-text p {
  font-size: 15px;
  color: var(--cv-gray);
  line-height: 1.75;
  margin-bottom: 24px;
}
.cv-blade-list { display: flex; flex-direction: column; gap: 12px; }
.cv-blade-list li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 500;
}
.cv-blade-list .check {
  width: 22px; height: 22px;
  background: var(--cv-orange);
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  flex-shrink: 0;
}

/* ── MATERIALS ── */
.cv-materials-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.cv-material-card {
  background: var(--cv-white);
  border: 1.5px solid var(--cv-border);
  border-radius: var(--cv-radius-lg);
  padding: 24px 16px;
  text-align: center;
  transition: border-color 0.2s, transform 0.2s;
}
.cv-material-card:hover {
  border-color: var(--cv-orange);
  transform: translateY(-3px);
}
.cv-material-emoji { font-size: 32px; margin-bottom: 10px; }
.cv-material-card h4 {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 6px;
}
.cv-material-card p {
  font-size: 12px;
  color: var(--cv-gray);
  line-height: 1.55;
}

/* ── COLORS ── */
.cv-colors-img {
  width: 100%;
  max-width: 800px;
  margin: 0 auto 28px;
  display: block;
  border-radius: var(--cv-radius-lg);
  box-shadow: var(--cv-shadow-lg);
}
.cv-color-label-row {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}
.cv-color-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 18px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
.cv-color-pill span {
  width: 12px; height: 12px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.6);
}

/* ── HOW IT WORKS ── */
.cv-steps-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  gap: 20px;
  align-items: center;
}
.cv-step-connector {
  font-size: 24px;
  color: var(--cv-orange);
  opacity: 0.5;
  text-align: center;
}
.cv-step-card {
  background: var(--cv-white);
  border: 1.5px solid var(--cv-border);
  border-radius: var(--cv-radius-lg);
  padding: 32px 24px;
  text-align: center;
  position: relative;
}
.cv-step-num {
  position: absolute;
  top: -16px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--cv-orange);
  color: #fff;
  width: 34px; height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 14px;
  box-shadow: 0 4px 12px rgba(242,100,25,0.3);
}
.cv-step-icon { font-size: 36px; margin: 10px 0 14px; }
.cv-step-card h3 {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 10px;
}
.cv-step-card p {
  font-size: 13px;
  color: var(--cv-gray);
  line-height: 1.65;
}

/* ── SPECS ── */
.cv-specs-table {
  max-width: 680px;
  margin: 0 auto;
  border: 1.5px solid var(--cv-border);
  border-radius: var(--cv-radius-lg);
  overflow: hidden;
}
.cv-spec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 24px;
  border-bottom: 1px solid var(--cv-border);
}
.cv-spec-row:last-child { border-bottom: none; }
.cv-spec-row:nth-child(even) { background: var(--cv-light); }
.cv-spec-label { font-size: 14px; color: var(--cv-gray); }
.cv-spec-val { font-size: 14px; font-weight: 700; color: var(--cv-dark); }

/* ── REVIEWS ── */
.cv-rating-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-bottom: 48px;
  background: var(--cv-light);
  border-radius: var(--cv-radius-lg);
  padding: 28px;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 48px;
}
.cv-big-num {
  font-size: 64px;
  font-weight: 900;
  color: var(--cv-dark);
  line-height: 1;
}
.cv-rating-stars { color: #f59e0b; font-size: 22px; letter-spacing: 3px; margin-bottom: 4px; }
.cv-rating-count { font-size: 13px; color: var(--cv-gray); }

.cv-reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.cv-review-card {
  background: var(--cv-white);
  border: 1.5px solid var(--cv-border);
  border-radius: var(--cv-radius-lg);
  padding: 24px;
  transition: border-color 0.2s, transform 0.2s;
}
.cv-review-card:hover {
  border-color: var(--cv-orange);
  transform: translateY(-3px);
}
.cv-review-stars { color: #f59e0b; font-size: 14px; letter-spacing: 2px; margin-bottom: 12px; }
.cv-review-text {
  font-size: 14px;
  color: var(--cv-gray);
  line-height: 1.7;
  margin-bottom: 18px;
  font-style: italic;
}
.cv-reviewer {
  display: flex;
  align-items: center;
  gap: 10px;
}
.cv-reviewer-avatar {
  width: 38px; height: 38px;
  background: linear-gradient(135deg, var(--cv-orange), #ff8c42);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 13px;
  color: #fff;
  flex-shrink: 0;
}
.cv-reviewer-name { font-size: 14px; font-weight: 700; display: block; }
.cv-reviewer-loc { font-size: 12px; color: var(--cv-gray); }
.cv-verified { font-size: 11px; color: var(--cv-green); font-weight: 600; margin-top: 10px; }

/* ── GUARANTEE ── */
.cv-guarantee-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.cv-guarantee-card {
  text-align: center;
  padding: 32px 20px;
  border-radius: var(--cv-radius-lg);
  border: 1.5px solid var(--cv-border);
  background: var(--cv-white);
}
.cv-guarantee-icon { font-size: 40px; margin-bottom: 14px; }
.cv-guarantee-card h3 {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 8px;
}
.cv-guarantee-card p {
  font-size: 13px;
  color: var(--cv-gray);
  line-height: 1.6;
}

/* ── FAQ ── */
.cv-faq-list {
  max-width: 740px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.cv-faq-item {
  border: 1.5px solid var(--cv-border);
  border-radius: var(--cv-radius);
  overflow: hidden;
  transition: border-color 0.2s;
}
.cv-faq-item.open { border-color: var(--cv-orange); }
.cv-faq-q {
  width: 100%;
  background: none;
  border: none;
  padding: 18px 22px;
  text-align: left;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  font-family: var(--cv-font);
  color: var(--cv-dark);
  transition: color 0.2s;
}
.cv-faq-q:hover { color: var(--cv-orange); }
.cv-faq-chevron {
  font-size: 22px;
  color: var(--cv-orange);
  flex-shrink: 0;
  transition: transform 0.25s;
  line-height: 1;
}
.cv-faq-item.open .cv-faq-chevron { transform: rotate(45deg); }
.cv-faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.25s;
  font-size: 14px;
  color: var(--cv-gray);
  line-height: 1.75;
}
.cv-faq-a.open {
  max-height: 240px;
  padding: 0 22px 18px;
}

/* ── FINAL CTA ── */
.cv-final-cta {
  background: var(--cv-orange);
  text-align: center;
  padding: 80px 24px;
}
.cv-final-cta h2 {
  font-size: clamp(24px, 4vw, 40px);
  font-weight: 900;
  color: #fff;
  margin-bottom: 14px;
}
.cv-final-cta p {
  color: rgba(255,255,255,0.85);
  font-size: 17px;
  max-width: 500px;
  margin: 0 auto 32px;
  line-height: 1.7;
}
.cv-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--cv-dark);
  color: #fff;
  padding: 18px 40px;
  border-radius: 50px;
  font-size: 17px;
  font-weight: 800;
  cursor: pointer;
  border: none;
  transition: background 0.2s, transform 0.15s;
  font-family: var(--cv-font);
}
.cv-cta-btn:hover { background: #374151; transform: translateY(-2px); }

